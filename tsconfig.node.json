{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*",
    "scripts/build-remote-backend.ts",
    "scripts/tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "@desirecore/electron-vite/node"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  }
}
