{
  "name": "orca-imboss",
  "version": "1.4.0",
  "description": "One man company agent",
  "main": "./out/main/index.js",
  "author": "kefroth@outlook.com",
  "homepage": "https://orca-studio.com/imboss/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sethyuan/orca-imboss.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "i18n:prune": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prune-translations.ts",
    "i18n:prune:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prune-translations.ts --dry-run",
    "db:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-db-csv.ts",
    "db:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-db-csv.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist:local": "pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --dir && codesign --force --deep --sign DevSelfSign 'dist/mac-arm64/imboss.app'",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "cronstrue": "^3.30.0",
    "electron-updater": "^6.8.9",
    "qq-official-bot": "1.3.0",
    "qrcode": "1.5.4",
    "typebox": "^1.3.21",
    "undici": "8.10.2",
    "wechat-ilink-client": "0.1.0"
  },
  "devDependencies": {
    "@desirecore/electron-vite": "6.0.0-beta.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.17.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "reactutils": "^5.13.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "^6.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "strip-markdown": "^6.0.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "valtio": "^2.3.2",
    "vite": "^7.3.6"
  }
}
